# Salin menjadi .env lalu sesuaikan.
#
# PENTING: jangan simpan password, token, atau secret apa pun di frontend.
# Semua yang masuk ke bundle React bisa dibaca siapa pun lewat browser.
# Variabel di bawah hanya dipakai vite.config.js (dev server), tidak ikut ke bundle.

# Alamat backend tujuan proxy /api saat `npm run dev`.
#   Backend di homeserver : https://metrohub.habibdev.site
#   Backend lokal         : http://localhost:3000   (default bila kosong)
API_PROXY_TARGET=http://localhost:3000
